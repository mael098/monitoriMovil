<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="880"
        x:Class="monitoriMovil.MainWindow"
        Title="monitoriMovil - Mirror + Control"
        Width="440" Height="880">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="4">
            <ComboBox x:Name="DeviceCombo" Width="140" />
            <Button x:Name="RefreshBtn" Content="Refrescar" />
            <Button x:Name="ConnectBtn" Content="Conectar" />
            <Button x:Name="StopBtn" Content="Detener" />
            <Button x:Name="FpsBtn" Content="FPS: ~30" />
            <TextBlock x:Name="RealFpsText" VerticalAlignment="Center" Margin="4,0,0,0" Text="0 FPS" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="LowQuality" />
                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Sin dispositivo" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="4" HorizontalAlignment="Center">
            <Button x:Name="BackBtn" Content="◀ Atrás" />
            <Button x:Name="HomeBtn" Content="● Inicio" />
            <Button x:Name="RecentsBtn" Content="▢ Recientes" />
            <Button x:Name="MenuBtn" Content="≡ Menú" />
            <Button x:Name="PowerBtn" Content="⏻ Bloq/Enc" />
            <Button x:Name="VolDownBtn" Content="Vol-" />
            <Button x:Name="VolUpBtn" Content="Vol+" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="4" HorizontalAlignment="Center">
            <Button x:Name="NotifBtn" Content="▼ Notificaciones" />
            <Button x:Name="QuickSettingsBtn" Content="▲ Ajustes rápidos" />
            <Button x:Name="WakeLockBtn" Content="🔒 Mantener encendida: OFF" />
            <Button x:Name="InstallApkBtn" Content="Instalar APK" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4" Margin="4" HorizontalAlignment="Center">
            <Button x:Name="TextBtn" Content="Enviar texto" />
            <Button x:Name="ScreenshotBtn" Content="Capturar pantalla" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Margin="6,0,0,0" Text="Toca, mantén para pulsación larga o arrastra" />
        </StackPanel>
    </Grid>
</Window>